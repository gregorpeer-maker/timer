{
  "name": "KFZ-Arbeitsplatz",
  "short_name": "KFZ-Arbeitsplatz",
  "description": "Arbeitsplatz für KFZ-Fachlehrer: Stundenplan, Erinnerungen, To-dos, Stoffverteilung und Timer.",
  "lang": "de",
  "id": "./index.html",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Timer", "url": "./timer.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "To-do-Liste", "url": "./index.html#/todo", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
